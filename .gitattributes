# Shell scripts are executed inside Linux containers: they must always be
# checked out with LF endings, whatever the developer's platform is.
*.sh            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.sql           text eol=lf

# Binary files, never converted.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.pdf           binary
*.gz            binary
