# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.  ".env" is git-ignored.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# "development", "testing" or "production".
APP_ENV=development
APP_NAME=Gestion de matériaux de construction

# --- Security (REQUIRED in production) --------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to 1 only when the site is served over HTTPS (it forces Secure cookies).
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Database (REQUIRED in production; MySQL) -------------------------------
# Example: mysql+pymysql://user:password@127.0.0.1:3306/building_materials?charset=utf8mb4
# Left empty in development, where a local SQLite file (instance/dev.db) is used.
DATABASE_URL=

# --- Localisation (Algerian defaults) ---------------------------------------
DEFAULT_LANGUAGE=ar
TIMEZONE=Africa/Algiers
CURRENCY=DZD
CURRENCY_SYMBOL=DA
DEFAULT_VAT_RATE=0.19

# --- Feature modules --------------------------------------------------------
FEATURE_WEIGHBRIDGE=1
FEATURE_FLEET=1
FEATURE_ACCOUNTING=0

# --- Development helpers ----------------------------------------------------
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=0
SQLALCHEMY_ECHO=0
