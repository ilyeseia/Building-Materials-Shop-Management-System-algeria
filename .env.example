# ===========================================================================
# Copy this file to ".env" and fill in the secrets.  ".env" is git-ignored.
#
#   cp .env.example .env
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # SECRET_KEY
#   openssl rand -hex 24                                            # passwords
#
# Use alphanumeric (hex) passwords: they are embedded in the MySQL connection
# URL, where characters such as "@" or ":" would need URL-encoding.
# Docker Compose refuses to start while the required values are empty.
# ===========================================================================

# --- Core ------------------------------------------------------------------
# "production" is the only supported value inside Docker.
APP_ENV=production
APP_NAME=Gestion de matériaux de construction

# Host interface and port published by Docker Compose.
#   127.0.0.1  reachable only from this machine (safe default)
#   0.0.0.0    reachable from the LAN / VPN
#   <ip>       bind one specific interface
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080

# --- Security (REQUIRED) ---------------------------------------------------
SECRET_KEY=

# Set to 1 only when the site is served over HTTPS (it forces Secure cookies;
# over plain HTTP the browser would drop the session cookie and login would
# appear to fail).
SESSION_COOKIE_SECURE=0

SESSION_LIFETIME_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Database (REQUIRED) ---------------------------------------------------
# The application connects to the "db" service over the internal Docker
# network; the database port is never published to the host.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=building_materials
MYSQL_USER=building_materials
MYSQL_PASSWORD=

# --- Algerian localisation defaults ----------------------------------------
DEFAULT_LANGUAGE=ar
TIMEZONE=Africa/Algiers
CURRENCY=DZD
CURRENCY_SYMBOL=DA
# Percentage, not a fraction: 19 means 19 % (Algerian standard VAT rate).
DEFAULT_VAT_RATE=19
# Market reference observations older than this are shown as "needs update".
# This never changes a selling price automatically.
MARKET_PRICE_STALE_DAYS=30

# --- Feature modules (1 = enabled, 0 = disabled) ---------------------------
FEATURE_WEIGHBRIDGE=1
FEATURE_FLEET=1
FEATURE_ACCOUNTING=0
# Read-only AI workspace.  It works without a provider (local deterministic
# assistant).  To use an OpenAI-compatible endpoint, set AI_PROVIDER=openai and
# AI_API_KEY.  A provider failure never affects sales, stock or accounting.
FEATURE_AI=1
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_TOOL_ROUNDS=3

# --- Gunicorn --------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info

# When the container sits behind a reverse proxy that terminates HTTPS, the
# proxy's address must be trusted for the X-Forwarded-Proto header, otherwise
# the application cannot tell that the request is secure (and secure cookies
# and HSTS would not be applied).  Set to "*" only when the application port is
# reachable exclusively through that proxy.
# FORWARDED_ALLOW_IPS=*

# --- First-run initialisation (scripts/docker-init.sh) ---------------------
# 1 = also insert the small demo catalogue (products only, no documents).
SEED_DEMO_DATA=0
# The script creates the administrator only when ADMIN_PASSWORD is set.
# Leaving it empty is the safer choice: run
#   docker compose exec app flask create-user --username admin --role admin
# and type the password at the prompt instead.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Backups (scripts/backup.sh) -------------------------------------------
BACKUP_RETENTION_DAYS=30
# Status page warns when the newest successful backup is older than this.
BACKUP_STALE_HOURS=48
# Optional signing secret for transparent license metadata.  No enforcement:
# a missing/expired/invalid license never disables the application.
# LICENSE_SECRET=
# Optional host-side scheduled backup settings (scripts/install-backup-schedule.sh):
# BACKUP_CRON=15 2 * * *
# BACKUP_REMOTE=remote:bmshop-backups
# BACKUP_NOTIFY_WEBHOOK=
